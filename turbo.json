{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "db:generate": {
      "outputs": ["drizzle/**/*.sql", "drizzle/**/*.ts"]
    },
    "db:migrate": {
      "dependsOn": ["db:generate"]
    },
    "db:studio": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:migrate"]
    },
    "db:push": {
      "dependsOn": ["db:generate"]
    }
  },
  "globalEnv": ["DATABASE_URL", "NODE_ENV"]
}